# Networking
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Server log level for structured router logs (INFO, WARNING, …)
LOG_LEVEL=INFO

# STT routing mode defaults: offline | enhanced
STT_DEFAULT_MODE=enhanced

# Local offline engine
VOSK_MODEL_DIR=pretrained_models/vosk-en

# Fallback provider config
# Supported values: none, gemini
STT_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated extra model ids to try after built-in fallbacks
# GEMINI_EXTRA_MODELS=
STT_FALLBACK_RETRIES=2
STT_FALLBACK_TIMEOUT_S=10

# Router policy thresholds
STT_MIN_CONFIDENCE=0.70
STT_MAX_NOISE_LEVEL_DB=30.0
STT_MIN_VAD_RATIO=0.10
STT_FAIL_THRESHOLD=2

